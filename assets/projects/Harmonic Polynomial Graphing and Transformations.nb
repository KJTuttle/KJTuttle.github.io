Notebook[{
Cell[BoxData[
 RowBox[{"Clear", "[", "\"\<Global*`\>\"", "]"}]], "Input",
 CellChangeTimes->{
  3.774060755773843*^9, {3.794582055498719*^9, 3.794582058581695*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"b70b22cb-f1c3-4e97-bccb-a588a4166369"],

Cell[TextData[{
 "\n",
 StyleBox["Plotting zeros of a single harmonic polynomial", "Subsection"],
 "\n\nThis code takes as input two arbitrary complex analytic polynomials, \
p[z] and q[z]. \n It then constructs the harmonic polynomial \
h[z]=p[z]+Conjugate[q[z]].  \n It uses NSlove to find the zeros of h[z] and \
then plots the zeros in the complex plane along with the unit circle. "
}], "Text",
 CellChangeTimes->{{3.740227042013301*^9, 3.740227147345215*^9}, {
  3.7402283127072678`*^9, 3.7402283172022314`*^9}, {3.7402286843800583`*^9, 
  3.740228710170306*^9}, {3.7402288345900993`*^9, 
  3.7402288347023993`*^9}},ExpressionUUID->"16703162-cc48-470c-88d3-\
db2809779408"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "\"\<Global*`\>\"", "]"}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Circles", " ", "family"}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", " ", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", " ", "=", " ", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"p", "[", "z_", "]"}], "=", 
    RowBox[{"z", "+", 
     RowBox[{"A", "*", 
      RowBox[{"z", "^", "2"}]}]}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"p", "[", "z", "]"}], " ", "can", " ", "be", " ", "any", " ", 
    "analytic", " ", "polynomial"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"q", "[", "z_", "]"}], "=", 
    RowBox[{
     RowBox[{"2", "*", "A", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"z", "^", 
         RowBox[{"(", 
          RowBox[{"n", "-", "1"}], ")"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"n", "-", "1"}], ")"}]}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"z", "^", "n"}], ")"}], "/", "n"}]}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"q", "[", "z", "]"}], " ", "can", " ", "be", " ", "any", " ", 
    "analytic", " ", "polynomial"}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Traditional", " ", "family"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A", " ", "=", " ", "1"}], ";", "\[IndentingNewLine]", 
    RowBox[{"B", " ", "=", " ", "1"}], ";", "\[IndentingNewLine]", 
    RowBox[{"n", " ", "=", " ", "7"}], ";", "\[IndentingNewLine]", 
    RowBox[{"k", " ", "=", " ", "6"}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"p", "[", "z_", "]"}], "=", 
     RowBox[{
      RowBox[{"A", "*", 
       RowBox[{"z", "^", "n"}]}], "+", "z"}]}], ";", "  ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"p", "[", "z", "]"}], " ", "can", " ", "be", " ", "any", " ", 
      "analytic", " ", "polynomial"}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"q", "[", "z_", "]"}], "=", 
     RowBox[{"B", "*", 
      RowBox[{"z", "^", "k"}]}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"q", "[", "z", "]"}], " ", "can", " ", "be", " ", "any", " ", 
     "analytic", " ", "polynomial"}], " ", "*)"}], "\[IndentingNewLine]", 
   "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DGraphHalfInteralLength", " ", "=", " ", "7"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DerP", "[", "z_", "]"}], "=", 
   RowBox[{
    RowBox[{"p", "'"}], "[", "z", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DerQ", "[", "z_", "]"}], "=", 
   RowBox[{
    RowBox[{"q", "'"}], "[", "z", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PDerP", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", " ", 
   RowBox[{"DerP", "[", 
    RowBox[{"x", "+", 
     RowBox[{"I", "*", "y"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PDerQ", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], " ", "=", " ", 
   RowBox[{"DerQ", "[", 
    RowBox[{"x", "+", 
     RowBox[{"I", "*", "y"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"h", "[", "z_", "]"}], "=", 
    RowBox[{
     RowBox[{"p", "[", "z", "]"}], "+", 
     RowBox[{"Conjugate", "[", 
      RowBox[{"q", "[", "z", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zeros", "=", 
   RowBox[{"NSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"h", "[", "z", "]"}], "\[Equal]", "0"}], ",", " ", "z"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
