Cell[TextData[{
 "\n\n\n",
 StyleBox["Image of Plane Under Harmonic Function", "Subsection"],
 "\n\nThis code allows the user to input a polynomial they wish to see the \
grid lines transformed under. It uses contour plot to plot the real part of \
h[x+Iy] in red and the imaginary part in grey."
}], "Text",
 CellChangeTimes->{{3.7402283489862914`*^9, 3.7402285578293133`*^9}, {
   3.740228630560438*^9, 3.7402286657082253`*^9}, {3.740228730576937*^9, 
   3.7402287446733103`*^9}, {3.740228811180236*^9, 3.740228815701379*^9}, 
   3.740234380579003*^9, {3.794244553715413*^9, 3.7942445647113457`*^9}, {
   3.794244991482155*^9, 3.7942450022446985`*^9}, {3.7945823884378853`*^9, 
   3.794582397429962*^9}, {3.7945826775285535`*^9, 
   3.794582699547441*^9}},ExpressionUUID->"fc0f14f9-523a-4fde-9f2b-\
7134859bf827"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global*`\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"p", "[", "z_", "]"}], "=", 
    RowBox[{
     RowBox[{"z", "^", "5"}], "+", "z"}]}], ";"}], 
  "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"q", "[", "z_", "]"}], "=", 
   RowBox[{"2", "*", 
    RowBox[{"z", "^", "4"}]}]}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "z_", "]"}], "=", 
   RowBox[{
    RowBox[{"p", "[", "z", "]"}], " ", "+", " ", 
    RowBox[{"Conjugate", "[", 
     RowBox[{"q", "[", "z", "]"}], "]"}]}]}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "polynomial", " ", "you", " ", "wish", " ", "to", " ", "see", 
    " ", "grid", " ", "lines", " ", "transformed", " ", "under"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"XYMIN", " ", "=", 
   RowBox[{"-", "4"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"XYMAX", " ", "=", " ", "4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CONTOURNUMBER", " ", "=", " ", "20"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"UnTransformedPic", " ", "=", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"ContourPlot", "[", 
     RowBox[{
      RowBox[{"Re", "[", 
       RowBox[{"x", "+", 
        RowBox[{"I", "*", "y"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "XYMIN", ",", "XYMAX"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", "XYMIN", ",", "XYMAX"}], "}"}], ",", 
      RowBox[{"ContourShading", "\[Rule]", "False"}], ",", " ", 
      RowBox[{"Contours", "\[Rule]", "CONTOURNUMBER"}], ",", 
      RowBox[{"ContourStyle", "\[Rule]", "Red"}]}], "]"}], ",", 
    RowBox[{"ContourPlot", "[", 
     RowBox[{
      RowBox[{"Im", "[", 
       RowBox[{"x", "+", 
        RowBox[{"I", "*", "y"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "XYMIN", ",", "XYMAX"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", "XYMIN", ",", "XYMAX"}], "}"}], ",", 
      RowBox[{"ContourShading", "\[Rule]", "False"}], ",", 
      RowBox[{"Contours", "\[Rule]", "CONTOURNUMBER"}]}], "]"}], ",", 
    RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
    RowBox[{"ImageSize", "\[Rule]", "400"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"TransformedPic", "=", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"ContourPlot", "[", 
     RowBox[{
      RowBox[{"Re", "[", 
       RowBox[{"h", "[", 
        RowBox[{"x", "+", 
         RowBox[{"I", "*", "y"}]}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "XYMIN", ",", "XYMAX"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", "XYMIN", ",", "XYMAX"}], "}"}], ",", 
      RowBox[{"ContourShading", "\[Rule]", "False"}], ",", " ", 
      RowBox[{"Contours", "\[Rule]", "CONTOURNUMBER"}], ",", " ", 
      RowBox[{"ContourStyle", "\[Rule]", "Red"}]}], "]"}], ",", 
    RowBox[{"ContourPlot", "[", 
     RowBox[{
      RowBox[{"Im", "[", 
       RowBox[{"h", "[", 
        RowBox[{"x", "+", 
         RowBox[{"I", "*", "y"}]}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "XYMIN", ",", "XYMAX"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", "XYMIN", ",", "XYMAX"}], "}"}], ",", 
      RowBox[{"ContourShading", "\[Rule]", "False"}], ",", " ", 
      RowBox[{"Contours", "\[Rule]", "CONTOURNUMBER"}]}], "]"}], ",", 
    RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
    RowBox[{"ImageSize", "\[Rule]", "400"}]}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.7402284378686633`*^9, 3.740228443387275*^9}, {
   3.7402285659384375`*^9, 3.7402286215268626`*^9}, {3.7402287544178433`*^9, 
