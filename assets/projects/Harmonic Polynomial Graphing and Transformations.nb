Cell[TextData[{
 "\n\n\n",
 StyleBox["Image of Concentric Circles Under Harmonic Function (Polar Form)", 
  "Subsection"],
 "\n\nThis code allows the user to input a harmonic polynomial they wish to \
see the concentric circles transformed under. It uses Polar Plot to plot the \
modulus of the output of our harmonic polynomial in polar coordinates."
}], "Text",
 CellChangeTimes->{{3.7402283489862914`*^9, 3.7402285578293133`*^9}, {
